{
  "name": "myelin",
  "version": "0.0.0",
  "private": true,
  "description": "A vault of Markdown notes that learns from how you write and navigate.",
  "license": "MIT",
  "type": "module",
  "main": "out/main/main.js",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && svelte-check --tsconfig ./tsconfig.web.json",
    "test": "vitest run",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "@myelin/graph": "^0.0.0",
    "better-sqlite3": "^13.2.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.4",
    "electron": "^45.5.0",
    "electron-vite": "^6.0.0",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "better-sqlite3": false
  }
}
